# Top-level workspace gitignore — applies to ALL sub-projects.
# Each sub-project (server/, website-chua-quan-am/, studio/) also has its own.

# Dependencies
**/node_modules/

# Secrets — NEVER commit
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# Build output
**/dist/
**/build/
**/out-tsc/
**/.angular/cache/
**/.sanity/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-error.log*

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Optional Claude memory directory references
**/.claude/
