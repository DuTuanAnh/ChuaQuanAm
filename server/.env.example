# Copy this file to `.env` and fill the real values. Never commit `.env`.

# ---------- Sanity CMS ----------
# Get these from https://www.sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Read token (optional). Required only if you query drafts / private datasets.
# Frontend MUST NOT see this token — keep it server-side only.
SANITY_TOKEN=

# Write token (REQUIRED for /api/registrations to create documents).
# Create at sanity.io/manage → project → API → Tokens → "Add API token"
# Permissions: Editor (can create + update documents).
# Without this, the registration form returns 503.
SANITY_WRITE_TOKEN=

# ---------- YouTube Data API v3 ----------
# Get from https://console.cloud.google.com/apis/credentials
# Restrict by HTTP referrer + scope to Data API v3 before deploying.
YOUTUBE_API_KEY=

# ---------- Server ----------
PORT=3000

# Optional: NODE_ENV=production enables the Sanity CDN cache.
NODE_ENV=development

# ---------- Email (Resend) ----------
# Sign up at https://resend.com (free 100 emails/day, 3000/month).
# Create API key → paste here. Without this, registration confirmation
# emails are skipped silently — registrations still work, but Phật tử
# won't get an email.
RESEND_API_KEY=
# Sender email. With a verified domain on Resend: "Chùa Quan Âm <noreply@chuaquanam.com>"
# Without verification, must use Resend's default: "Chùa Quan Âm <onboarding@resend.dev>"
RESEND_FROM_EMAIL=

# ---------- Sanity Webhook ----------
# Secret used to verify Sanity webhook requests (HMAC-SHA256).
# Generate a random 32-byte string, paste here, and use the SAME value when
# creating the webhook in sanity.io/manage → API → Webhooks.
# Generate: openssl rand -hex 32  (or any password generator)
SANITY_WEBHOOK_SECRET=

# ---------- CORS ----------
# Comma-separated production frontend origins (Vercel/Netlify domain).
# Localhost origins are always allowed automatically.
# Example: CORS_ORIGINS=https://chuaquanam.vercel.app,https://chuaquanam.com
CORS_ORIGINS=

# ---------- Cache admin (Basic Auth for DELETE /api/cache/clear) ----------
# Both must be set, otherwise the cache-clear endpoint returns 503.
CACHE_ADMIN_USER=
CACHE_ADMIN_PASS=
